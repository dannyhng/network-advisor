---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Network Blueprint Advisor | Danny Hoang">
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-logo">DH<span class="dot">.</span><span class="console">_</span></a>
      <div class="nav-links">
        <a href="https://github.com/dannyhng/network-advisor" target="_blank" class="nav-btn">View Code</a>
      </div>
    </div>
  </nav>

  <div class="grid-bg"></div>

  <main>
    <div class="advisor-hero">
      <p class="advisor-label">Systems Architecture Tool</p>
      <h1>Network <span class="highlight">Blueprint</span> Advisor</h1>
      <p class="advisor-sub">Generate secure, scalable network designs based on your environment, workload, and budget.</p>
      <div class="hero-badges">
        <span class="badge">Zero Trust</span>
        <span class="badge">VLAN Segmentation</span>
        <span class="badge">HA Ready</span>
      </div>
    </div>

    <div class="advisor-shell">
      <div class="progress-terminal" id="progress-terminal">
        <span class="pt-bracket">[</span><span class="pt-filled" id="pt-filled"></span><span class="pt-empty" id="pt-empty"></span><span class="pt-bracket">]</span>
        <span class="pt-label" id="pt-label">00 / 07</span>
      </div>

      <div id="questions-container">

        <!-- Q0: Intro -->
        <div class="question active" data-q="0">
          <div class="q-header"><span class="q-num">START</span><h2>Design your network architecture.</h2></div>
          <p class="q-sub">Most consumer routers aren't designed for segmented or high-device environments.
          Answer a few questions to generate a network design tailored to your setup and budget.</p>
          <div class="exp-box">
            <strong>What we'll cover:</strong>
            <ul style="margin-top: 10px; padding-left: 1.2rem; color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
              <li><strong>Hardware Selection:</strong> Gear matched to your budget and requirements</li>
              <li><strong>Network Segmentation:</strong> Segmentation strategies for IoT and guest systems</li>
              <li><strong>Routing & VPN:</strong> Practical routing design and remote access</li>
              <li><strong>Deployment Plan:</strong> Step-by-step implementation approach</li>
            </ul>
          </div>
          <button class="next-btn pulse-btn" onclick="nextQuestion()" style="margin-top: 2rem;">Start the Assessment →</button>
        </div>

        <!-- Q1: Audience -->
        <div class="question" data-q="1">
          <div class="q-header"><span class="q-num">01</span><h2>Primary Objective</h2></div>
          <div class="options-grid">
            <button class="option-card" data-key="audience" data-val="home" onclick="select(this)">
              <div class="card-title">Home Network</div><p>Reliable connectivity for family and daily use.</p>
            </button>
            <button class="option-card" data-key="audience" data-val="business" onclick="select(this)">
              <div class="card-title">Business Network</div><p>Security, uptime, and client-facing performance.</p>
            </button>
            <button class="option-card" data-key="audience" data-val="homelab" onclick="select(this)">
              <div class="card-title">Homelab</div><p>Experimentation, self-hosting, and skill development.</p>
            </button>
          </div>
        </div>

        <!-- Q2: Budget -->
        <div class="question" data-q="2">
          <div class="q-header"><span class="q-num">02</span><h2>Hardware Budget</h2></div>
          <div class="options-grid">
            <button class="option-card" data-key="budget" data-val="low" onclick="select(this)">
              <div class="card-title">Budget (&lt;$200)</div><p>Entry-level or repurposed hardware suitable for small segmented networks</p>
            </button>
            <button class="option-card" data-key="budget" data-val="mid" onclick="select(this)">
              <div class="card-title">Mid-Tier ($200-$600)</div><p>Prosumer gear with VLAN support and centralized management</p>
            </button>
            <button class="option-card" data-key="budget" data-val="high" onclick="select(this)">
              <div class="card-title">Enterprise ($1000+)</div><p>Enterprise-grade routing, switching, and scalable infrastructure</p>
            </button>
          </div>
        </div>

        <!-- Q3: Density -->
        <div class="question" data-q="3">
          <div class="q-header"><span class="q-num">03</span><h2>Network Density</h2></div>
          <div class="options-grid">
            <button class="option-card" data-key="density" data-val="small" onclick="select(this)"><div class="card-title">1-20 Devices</div><p>Small household or micro-office setup.</p></button>
            <button class="option-card" data-key="density" data-val="medium" onclick="select(this)"><div class="card-title">21-60 Devices</div><p>Medium density with mixed device types.</p></button>
            <button class="option-card" data-key="density" data-val="large" onclick="select(this)"><div class="card-title">61+ Devices</div><p>High-density environment requiring scalable design.</p></button>
          </div>
        </div>

        <!-- Q4: Traffic Profiles -->
        <div class="question" data-q="4">
          <div class="q-header"><span class="q-num">04</span><h2>Traffic Profiles</h2></div>
          <p class="q-sub">Select all that apply to your environment.</p>
          <div class="options-grid">
            <button class="option-card multi-btn" data-key="types" data-val="iot" onclick="toggleMulti(this)"><div class="card-title">IoT / Smart Home</div><p>Smart devices, sensors, bulbs, speakers.</p></button>
            <button class="option-card multi-btn" data-key="types" data-val="servers" onclick="toggleMulti(this)"><div class="card-title">NAS / Local Servers</div><p>File sharing, Plex, self-hosted apps.</p></button>
            <button class="option-card multi-btn" data-key="types" data-val="cameras" onclick="toggleMulti(this)"><div class="card-title">IP Surveillance</div><p>IP cameras and NVR systems.</p></button>
            <button class="option-card multi-btn" data-key="types" data-val="guest" onclick="toggleMulti(this)"><div class="card-title">Guest Access</div><p>Isolated internet-only access for visitors.</p></button>
          </div>
          <button class="next-btn" id="multi-next" onclick="nextFromMulti()" style="display:none; margin-top: 1.5rem;">Continue with Selection →</button>
          <button class="btn-skip" onclick="skipMulti()" style="margin-top: 0.8rem; width: 100%;">None of these apply →</button>
        </div>

        <!-- Q5: High Availability -->
        <div class="question" data-q="5">
          <div class="q-header"><span class="q-num">05</span><h2>High Availability Strategy</h2></div>
          <p class="q-sub">Define the desired level of uptime and failure tolerance for this network.</p>
          <div class="options-grid">
            <button class="option-card" data-key="ha" data-val="yes" onclick="select(this)">
              <div class="card-title">Redundant</div><p>Redundant hardware paths to minimize downtime during failures.</p>
            </button>
            <button class="option-card" data-key="ha" data-val="no" onclick="select(this)">
              <div class="card-title">Standard</div><p>Single path is acceptable for this site.</p>
            </button>
          </div>
        </div>

        <!-- Q6: Power -->
        <div class="question" data-q="6">
          <div class="q-header"><span class="q-num">06</span><h2>Power Protection Strategy</h2></div>
          <p class="q-sub">How should the infrastructure handle power loss or electrical instability?</p>
          <div class="options-grid">
            <button class="option-card" data-key="power" data-val="ups" onclick="select(this)">
              <div class="card-title">Battery Backup (UPS)</div><p>Keeps critical systems running during outages and protects against power instability.</p>
            </button>
            <button class="option-card" data-key="power" data-val="standard" onclick="select(this)">
              <div class="card-title">Surge Protection</div><p>Basic protection against spikes; system hard-reboots during outages.</p>
            </button>
          </div>
        </div>

        <!-- Q7: Backup -->
        <div class="question" data-q="7">
          <div class="q-header"><span class="q-num">07</span><h2>Backup Strategy</h2></div>
          <p class="q-sub">Define your data protection and recovery requirements.</p>
          <div class="options-grid">
            <button class="option-card" data-key="backup" data-val="hybrid" onclick="select(this)">
              <div class="card-title">Hybrid (3-2-1 Rule)</div><p>Local NAS with encrypted cloud backup for redundancy and recovery.</p>
            </button>
            <button class="option-card" data-key="backup" data-val="local" onclick="select(this)">
              <div class="card-title">Local Only</div><p>On-site backup to a NAS or external drive only.</p>
            </button>
          </div>
        </div>

        <div style="margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1rem;">
          <button id="prev-btn" onclick="prevQuestion()" style="background:none; border:none; color:var(--text-secondary); cursor:pointer; visibility:hidden; font-weight: 600; font-size: 0.95rem;">← Previous Step</button>
        </div>

      </div><!-- /questions-container -->

      <!-- RESULTS -->
      <div id="results" class="results-container" style="display:none; opacity:0;">
        <div id="selection-summary"></div>
        <div class="results-top"></div>

        <div class="blueprint-grid">
          <div class="blueprint-card" data-reveal><h3>Hardware Stack</h3><div id="res-hardware" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal><h3>Logical Topology</h3><div id="res-routing" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal><h3>Routing Strategy</h3><div id="res-protocol" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal><h3>Remote Access</h3><div id="res-remote" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal><h3>Security Zones</h3><div id="res-vlan" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal><h3>Deployment Roadmap</h3><div id="res-security" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal id="power-card"><h3>Physical & Power Layer</h3><div id="res-power" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal id="isp-card"><h3>ISP & External Link</h3><div id="res-isp" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal id="dns-card"><h3>DNS Architecture</h3><div id="res-dns" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal id="storage-card" style="display:none"><h3>Storage Layer</h3><div id="res-storage" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal id="software-card" style="display:none"><h3>Software Stack</h3><div id="res-software" class="res-content"></div></div>
          <div class="blueprint-card" data-reveal id="logic-card" style="grid-column: 1 / -1; border-top: 2px solid var(--accent); margin-top: 1rem;">
            <h3>Why this design works</h3>
            <div id="res-logic" class="res-content" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;"></div>
          </div>
        </div>

        <div class="blueprint-actions">
          <button class="btn-primary" onclick="downloadPDF()">Download PDF</button>
          <button class="btn-outline" onclick="exportMarkdown()">Copy Markdown</button>
          <button class="btn-outline" onclick="saveResults()">Save Blueprint</button>
          <button class="btn-outline" onclick="location.reload()">Start New Blueprint</button>
        </div>

        <div class="contact-cta">
          <h3>Need a Professional Build?</h3>
          <p>I design and deploy secure, high-performance infrastructure for Homelabs and SMBs.</p>
          <div class="cta-links">
            <a href="mailto:thuvhoang19@gmail.com" class="btn-primary">Email Danny</a>
            <a href="https://linkedin.com/in/vietthuhoang/" target="_blank" class="btn-outline">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Syne:wght@700;800&family=Inter:wght@400;500;600&display=swap');

  :root {
    --bg-deep: #080e1a;
    --bg-card: #0f1c2e;
    --bg-card-hover: #162438;
    --accent: #10b981;
    --accent-dim: rgba(16, 185, 129, 0.15);
    --accent-glow: rgba(16, 185, 129, 0.3);
    --accent-glow-strong: rgba(16, 185, 129, 0.6);
    --text-primary: #f0f6ff;
    --text-secondary: #a8bdd4;
    --border: #1e3050;
    --border-accent: rgba(16, 185, 129, 0.4);
  }

  *, *::before, *::after { box-sizing: border-box; }

  body {
    background: var(--bg-deep);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    margin: 0;
    overflow-x: hidden;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
  }

  /* --- Grid Background --- */
  .grid-bg {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(16,185,129,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16,185,129,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }
  .grid-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(16,185,129,0.08) 0%, transparent 70%);
  }

  main { display: flex; flex-direction: column; align-items: center; width: 100%; position: relative; z-index: 1; }

  /* --- Navbar --- */
  .navbar {
    width: 100%;
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
    background: rgba(8, 14, 26, 0.85);
    backdrop-filter: blur(16px);
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .nav-container { max-width: 1100px; margin: auto; display: flex; justify-content: space-between; align-items: center; padding: 0 1.5rem; }
  .nav-logo { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 1.2rem; text-decoration: none; color: white; letter-spacing: -1px; }
  .dot { color: var(--accent); }
  .console { color: var(--accent); animation: blink 1s infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .nav-btn {
    border: 1px solid var(--accent);
    color: var(--accent) !important;
    padding: 0.4rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    font-family: 'JetBrains Mono', monospace;
    transition: all 0.2s;
  }
  .nav-btn:hover { background: var(--accent-dim); box-shadow: 0 0 12px var(--accent-glow); }

  /* --- Hero --- */
  .advisor-hero {
    text-align: center;
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 5rem 1.5rem 9rem;
    animation: fadeUp 0.8s ease-out both;
  }
  .advisor-label {
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 1.2rem;
  }
  .advisor-hero h1 {
    font-family: 'Syne', sans-serif;
    font-size: 3.2rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -1px;
    line-height: 1.1;
  }
  .highlight {
    color: var(--accent);
    text-shadow: 0 0 20px rgba(16, 185, 129, 0.4);
  }
  .advisor-sub {
    color: var(--text-secondary);
    max-width: 560px;
    margin: 1.2rem auto 1.8rem;
    line-height: 1.7;
    font-size: 1.05rem;
  }
  .hero-badges { display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center; }
  .badge {
    background: var(--accent-dim);
    border: 1px solid var(--border-accent);
    color: var(--accent);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.5px;
  }

  /* --- Shell --- */
  .advisor-shell {
    width: 92%;
    max-width: 960px;
    margin: -5.5rem auto 7rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 3rem;
    box-shadow: 0 40px 80px -20px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.03);
    position: relative;
    z-index: 10;
    animation: fadeUp 0.8s 0.2s ease-out both;
  }

  /* --- Terminal Progress --- */
  .progress-terminal {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .pt-bracket { color: var(--border-accent); }
  .pt-filled { color: var(--accent); letter-spacing: 1px; }
  .pt-empty { color: var(--border); letter-spacing: 1px; }
  .pt-label { margin-left: 0.8rem; color: var(--accent); font-weight: 700; }

  /* --- Questions --- */
  .question { display: none; }
  .question.active { display: block; }
  .question.slide-in { animation: slideIn 0.35s cubic-bezier(0.4, 0, 0.2, 1) both; }
  .question.slide-in-back { animation: slideInBack 0.35s cubic-bezier(0.4, 0, 0.2, 1) both; }
  @keyframes slideIn { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes slideInBack { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  .q-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.6rem; }
  .q-num { font-family: 'JetBrains Mono', monospace; color: var(--accent); font-size: 0.85rem; font-weight: 700; background: var(--accent-dim); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--border-accent); }
  .question h2 { font-family: 'Syne', sans-serif; font-size: 1.65rem; margin: 0; font-weight: 700; }
  .q-sub { color: var(--text-secondary); margin-bottom: 2rem; font-size: 1rem; line-height: 1.7; }

  /* --- Cards --- */
  .options-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .option-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    padding: 1.3rem;
    border-radius: 10px;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s;
    color: var(--text-primary);
    position: relative;
    overflow: hidden;
  }
  .option-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, var(--accent-glow) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .option-card:hover { border-color: var(--border-accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3), 0 0 0 1px var(--border-accent); }
  .option-card:hover::before { opacity: 0.5; }
  .option-card.selected { border-color: var(--accent); background: var(--accent-dim); box-shadow: 0 0 20px var(--accent-glow), inset 0 0 20px rgba(16,185,129,0.05); }
  .option-card.selected::before { opacity: 1; }
  .card-title { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.4rem; letter-spacing: 0.2px; }
  .option-card p { font-size: 0.9rem; line-height: 1.5; margin-top: 0.3rem; color: var(--text-secondary); }

  /* --- Buttons --- */
  .next-btn {
    margin-top: 2rem;
    background: var(--accent);
    color: var(--bg-deep);
    border: none;
    padding: 1rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    width: 100%;
    transition: all 0.2s;
    font-family: 'Inter', sans-serif;
  }
  .next-btn:hover { opacity: 0.9; box-shadow: 0 0 24px var(--accent-glow-strong); transform: translateY(-1px); }
  .pulse-btn { animation: pulse-glow 2.5s ease-in-out infinite; }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 0 0 var(--accent-glow); }
    50% { box-shadow: 0 0 0 8px transparent; }
  }
  .btn-skip {
    background: transparent;
    border: 1px dashed var(--border);
    color: var(--text-secondary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Inter', sans-serif;
  }
  .btn-skip:hover { border-color: var(--accent); color: var(--accent); }
  .exp-box {
    background: rgba(255,255,255,0.02);
    padding: 1rem 1.2rem;
    border-radius: 6px;
    margin-top: 1rem;
    font-size: 0.9rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* --- Results --- */
  .results-container { transition: opacity 0.5s ease; }
  .blueprint-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }

  /* Staggered reveal */
  .blueprint-card[data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.2s, box-shadow 0.2s;
  }
  .blueprint-card[data-reveal].visible {
    opacity: 1;
    transform: translateY(0);
  }

  .blueprint-card {
    background: rgba(255,255,255,0.015);
    border-left: 3px solid var(--accent);
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.8rem;
    border-radius: 4px 8px 8px 4px;
  }
  .blueprint-card:hover { border-color: var(--border-accent); box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
  .blueprint-card h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .res-content { font-size: 0.97rem; line-height: 1.75; color: var(--text-secondary); }

  /* --- Results Header --- */
  .results-top { margin-bottom: 2rem; }

  /* --- Summary Bar --- */
  #selection-summary { border-radius: 8px; }

  /* --- Actions --- */
  .blueprint-actions { margin-top: 3rem; display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary, .btn-outline {
    padding: 0.9rem 1.8rem;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    font-size: 0.9rem;
    transition: all 0.2s;
    font-family: 'Inter', sans-serif;
  }
  .btn-primary { background: var(--accent); color: var(--bg-deep); border: none; flex: 1.5; }
  .btn-primary:hover { box-shadow: 0 0 24px var(--accent-glow-strong); transform: translateY(-1px); }
  .btn-outline { background: transparent; border: 1px solid var(--border); color: var(--text-primary); flex: 1; }
  .btn-outline:hover { border-color: var(--border-accent); background: var(--accent-dim); }

  /* --- CTA --- */
  .contact-cta {
    margin-top: 4rem;
    text-align: center;
    padding: 3rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(16,185,129,0.03);
  }
  .contact-cta h3 { font-family: 'Syne', sans-serif; font-size: 1.5rem; margin: 0 0 0.5rem; }
  .contact-cta p { color: var(--text-secondary); margin: 0 0 1.5rem; }
  .cta-links { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

  /* --- Topology --- */
  .topology-simple { text-align: center; margin-top: 1.5rem; }
  .top-section {
    background: rgba(16,185,129,0.08);
    border: 1px solid var(--border-accent);
    padding: 0.8rem 1.2rem;
    border-radius: 6px;
    margin: 0.5rem auto;
    width: fit-content;
    color: white;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }
  .arrow { color: var(--accent); margin: 0.3rem 0; font-weight: bold; font-size: 1.2rem; }

  /* --- Toast --- */
  .toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--accent);
    color: var(--text-primary);
    padding: 1rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    z-index: 9999;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 0 16px var(--accent-glow);
    animation: toastIn 0.3s ease, toastOut 0.3s ease 2.7s both;
  }
  @keyframes toastIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
  @keyframes toastOut { from { opacity:1; } to { opacity:0; } }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .advisor-hero h1 { font-size: 2.4rem; }
    .advisor-hero { padding: 3rem 1.5rem; min-height: auto; }
    .advisor-shell { padding: 1.5rem; margin: 1rem auto 4rem; width: 95%; }
    .blueprint-grid { grid-template-columns: 1fr; gap: 1rem; }
    .blueprint-actions, .cta-links { flex-direction: column; }
    .btn-primary, .btn-outline { flex: none; width: 100%; }
  }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script is:inline>
  const answers = {};
  const multiSelections = new Set();
  let currentQ = 0;
  const totalQ = 7;
  let goingBack = false;

  // Load saved answers
  const saved = localStorage.getItem('networkBlueprint');
  if (saved) {
    try { Object.assign(answers, JSON.parse(saved)); }
    catch (e) { localStorage.removeItem('networkBlueprint'); }
  }

  // Toast helper
  function showToast(msg) {
    const t = document.createElement('div');
    t.className = 'toast';
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3100);
  }

  // --- Question Navigation ---
  window.select = function(btn) {
    const key = btn.dataset.key;
    const val = btn.dataset.val;
    answers[key] = val;
    btn.parentElement.querySelectorAll('.option-card').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    setTimeout(() => nextQuestion(), 380);
  }

  window.toggleMulti = function(btn) {
    const val = btn.dataset.val;
    multiSelections.has(val) ? multiSelections.delete(val) : multiSelections.add(val);
    btn.classList.toggle('selected');
    document.getElementById('multi-next').style.display = multiSelections.size > 0 ? 'block' : 'none';
  }

  window.nextFromMulti = function() {
    answers['types'] = Array.from(multiSelections);
    multiSelections.clear();
    nextQuestion();
  }

  // FIX: Smart defaults based on audience instead of empty array
  window.skipMulti = function() {
    multiSelections.clear();
    const defaults = {
      home:     ['guest'],
      business: ['guest', 'servers'],
      homelab:  ['servers']
    };
    answers['types'] = defaults[answers['audience']] || [];
    nextQuestion();
  }

  function nextQuestion() {
    if (currentQ >= totalQ) { showResults(); return; }
    const current = document.querySelector(`.question[data-q="${currentQ}"]`);
    current.classList.remove('active', 'slide-in', 'slide-in-back');
    currentQ++;
    goingBack = false;
    const next = document.querySelector(`.question[data-q="${currentQ}"]`);
    next.classList.add('active', 'slide-in');
    updateNavUI();
  }

  window.prevQuestion = function() {
    if (currentQ <= 0) return;
    const current = document.querySelector(`.question[data-q="${currentQ}"]`);
    current.classList.remove('active', 'slide-in', 'slide-in-back');
    currentQ--;
    goingBack = true;
    const prev = document.querySelector(`.question[data-q="${currentQ}"]`);
    prev.classList.add('active', 'slide-in-back');
    updateNavUI();
  }

  function updateNavUI() {
    const TOTAL_BLOCKS = 20;
    const filled = Math.round((currentQ / totalQ) * TOTAL_BLOCKS);
    const empty  = TOTAL_BLOCKS - filled;
    document.getElementById('pt-filled').textContent = '\u2588'.repeat(filled);
    document.getElementById('pt-empty').textContent  = '\u2591'.repeat(empty);
    document.getElementById('pt-label').textContent  =
      (currentQ === 0 ? '00' : String(currentQ).padStart(2, '0')) + ' / ' + String(totalQ).padStart(2, '0');
    document.getElementById('prev-btn').style.visibility = currentQ > 0 ? 'visible' : 'hidden';
  }

  window.saveResults = function() {
    localStorage.setItem('networkBlueprint', JSON.stringify(answers));
    showToast('Saved. Blueprint cached for your next session.');
  }

  // --- Typewriter Effect ---
  function typewriter(el, text, speed = 28) {
    el.textContent = '';
    let i = 0;
    const tick = () => {
      if (i < text.length) { el.textContent += text[i++]; setTimeout(tick, speed); }
    };
    tick();
  }

  // --- Staggered Card Reveal with h3 typewriter ---
  function revealCards() {
    const cards = document.querySelectorAll('.blueprint-card[data-reveal]');
    cards.forEach((card, i) => {
      setTimeout(() => {
        card.classList.add('visible');
        const h3 = card.querySelector('h3');
        if (h3) {
          const label = h3.textContent;
          typewriter(h3, label, 22);
        }
      }, i * 100);
    });
  }

  // --- showResults ---
  function showResults() {
    const r = answers;

    if (!r.audience || !r.budget || !r.density || !r.ha) {
      showToast('Incomplete input. Please restart the assessment.');
      location.reload();
      return;
    }

    const hero = document.querySelector('.advisor-hero');
    const shell = document.querySelector('.advisor-shell');
    const container = document.getElementById('questions-container');
    const summaryBar = document.getElementById('selection-summary');

    if (hero) hero.style.display = 'none';
    container.style.display = 'none';
    document.getElementById('progress-terminal').style.display = 'none';
    document.getElementById('prev-btn').style.display = 'none';

    if (window.innerWidth > 768) {
      shell.style.marginTop = '4rem';
      shell.style.padding = '3rem';
    } else {
      shell.style.marginTop = '1.5rem';
      shell.style.padding = '1.2rem';
    }

    const types = r.types || [];
    const isBiz = r.audience === 'business';
    const isLab = r.audience === 'homelab';
    const hasHA = r.ha === 'yes' && r.budget === 'high';

    const audienceMap = { home: 'Home', business: 'Business', homelab: 'Homelab' };
    const budgetMap   = { low: '<$200', mid: '$200–$600', high: '$1k+' };
    const densityMap  = { small: '1–20 Devices', medium: '21–60 Devices', large: '61+ Devices' };
    const costMap     = { low: '$150 – $450', mid: '$700 – $1,500', high: '$2,500 – $4,000+' };

    // Summary bar
    summaryBar.innerHTML = `
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:0.8rem;font-family:'JetBrains Mono',monospace;font-size:0.85rem;">
        <div><span style="color:var(--accent)">ENV</span><br/>${audienceMap[r.audience]}</div>
        <div><span style="color:var(--accent)">SCALE</span><br/>${densityMap[r.density]}</div>
        <div><span style="color:var(--accent)">BUDGET</span><br/>${budgetMap[r.budget]}</div>
        <div><span style="color:var(--accent)">HA</span><br/>${hasHA ? 'Enabled' : 'Standard'}</div>
        <div><span style="color:var(--accent)">POWER</span><br/>${r.power === 'ups' ? 'UPS' : 'Surge'}</div>
        <div><span style="color:var(--accent)">BACKUP</span><br/>${r.backup === 'hybrid' ? '3-2-1' : 'Local'}</div>
      </div>`;
    summaryBar.style.cssText = 'border:1px solid var(--border);background:rgba(16,185,129,0.03);padding:1.2rem;margin-bottom:1.8rem;border-radius:8px;';

    // Results header
    const titleEl = document.createElement('div');
    titleEl.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:2rem;border-bottom:1px solid var(--border);padding-bottom:2rem;margin-bottom:2rem;">
        <div style="flex:1 1 300px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--accent);letter-spacing:2px;text-transform:uppercase;font-weight:700;margin-bottom:0.5rem;">Architecture Summary</div>
          <h2 id="results-title" style="margin:0 0 0.5rem;font-family:'Syne',sans-serif;font-size:2rem;line-height:1.2;"></h2>
          <p style="color:var(--text-secondary);font-size:1rem;margin:0;max-width:480px;line-height:1.7;">
            Designed for <strong style="color:var(--text-primary)">${densityMap[r.density]}</strong> with a focus on 
            <strong style="color:var(--text-primary)">${hasHA ? 'high availability' : 'segmentation and control'}</strong>.
          </p>
        </div>
        <div style="flex:1 1 220px;background:rgba(255,255,255,0.02);padding:1.5rem;border-radius:8px;border:1px solid var(--border);">
          <div style="font-family:'JetBrains Mono',monospace;font-size:0.72rem;color:var(--text-secondary);text-transform:uppercase;font-weight:600;margin-bottom:0.4rem;letter-spacing:1px;">Estimated Cost</div>
          <div style="font-family:'Syne',sans-serif;font-size:1.9rem;font-weight:800;color:var(--accent);line-height:1.1;margin-bottom:0.5rem;">${costMap[r.budget]}</div>
          <p style="font-size:0.82rem;color:var(--text-secondary);margin:0;line-height:1.5;">Varies by vendor, licensing & availability.</p>
          ${r.budget === 'high' ? `<p style="font-size:0.82rem;color:var(--accent);margin:0.8rem 0 0;font-weight:600;border-top:1px dashed var(--border);padding-top:0.8rem;">Enterprise licensing costs may apply.</p>` : ''}
        </div>
      </div>`;
    document.querySelector('.results-top').appendChild(titleEl);
    setTimeout(() => typewriter(document.getElementById('results-title'), `${audienceMap[r.audience]} Network Design`), 300);

    // --- Hardware ---
    let hw = '';
    if (r.budget === 'high') {
      hw = `<strong>Edge:</strong> Netgate 6100 ${hasHA ? 'HA Pair' : '(Standalone)'}<br/>
            <strong>Core Switch:</strong> Cisco Catalyst 9200L (L3 Managed)<br/>
            <strong>WLAN:</strong> 2× UniFi U7 Pro (Wi-Fi 7 / 6GHz)`;
    } else if (r.budget === 'mid') {
      hw = `<strong>Gateway:</strong> UniFi Cloud Gateway Max<br/>
            <strong>Switch:</strong> UniFi Pro Max 16 PoE<br/>
            <strong>WLAN:</strong> 2× UniFi U7 Pro`;
    } else {
      hw = `<strong>Gateway:</strong> x86 Mini PC running OPNsense<br/>
            <strong>Switch:</strong> TP-Link L2 Managed<br/>
            <strong>WLAN:</strong> TP-Link Omada AP`;
    }
    const icLink = r.budget === 'high' ? '10Gbps SFP+ DAC' : (r.budget === 'mid' ? 'Cat6a 10G Copper' : 'Cat6 Ethernet');
    hw += `<div class="exp-box"><strong>Interconnect:</strong> Use <strong>${icLink}</strong> for the switch-to-firewall uplink to eliminate backplane bottlenecks.</div>`;
    if (r.budget === 'high') hw += `<div class="exp-box"><strong>Note:</strong> Enterprise switching platforms may require additional licensing and support contracts.</div>`;
    document.getElementById('res-hardware').innerHTML = hw;

    // --- Power Layer ---
    const powerHw = r.power === 'ups' ? 'APC Smart-UPS 1500VA' : 'CyberPower CSP604U Surge Protector';
    const rackHw  = r.audience === 'home' ? 'StarTech 6U Wall Mount' : '12U Open Frame Server Rack';
    document.getElementById('res-power').innerHTML = `
      <strong>Rack:</strong> ${rackHw}<br/>
      <strong>Power:</strong> ${powerHw}<br/>
      ${r.power === 'ups' ? '<div class="exp-box"><strong>Runtime Tip:</strong> Pair the UPS with a network card for SNMP monitoring and get graceful shutdown alerts before the battery runs out.</div>' : '<div class="exp-box"><strong>Note:</strong> Budget UPS units (CyberPower CP685AVR) are a worthwhile upgrade even at low budget; they protect against voltage sags that kill switches silently.</div>'}
    `;

    // --- ISP Layer ---
    document.getElementById('res-isp').innerHTML = `
      <strong>Modem Config:</strong> Bridge Mode / IP Passthrough<br/>
      <strong>DNS:</strong> See DNS Architecture card<br/>
      <div class="exp-box"><strong>Critical:</strong> Bridge Mode avoids Double NAT, which is essential for stable VPN tunnels and correct port forwarding. Your firewall gets the real public IP directly.</div>
      <div class="exp-box"><strong>ISP Caveat:</strong> Some providers (AT&T Fiber, Comcast XB gateways) resist true bridge mode or require their hardware to stay inline. Check your ISP's bridge mode support before designing around it. IP Passthrough is the fallback when full bridge is blocked.</div>
    `;

    // --- DNS Architecture ---
    const dnsLocal = r.audience !== 'home' || types.includes('iot') || types.includes('servers');
    const dnsResolver = r.budget === 'low'
      ? 'Pi-hole (Raspberry Pi or x86 VM)'
      : 'AdGuard Home or Unbound (recursive resolver)';
    document.getElementById('res-dns').innerHTML = dnsLocal
      ? `<strong>Upstream Resolvers:</strong> Quad9 (9.9.9.9) + Cloudflare (1.1.1.1) as fallback<br/>
         <strong>Local Resolver:</strong> ${dnsResolver}<br/>
         <p style="font-size:0.9rem;margin-top:6px;margin-bottom:0;">Run the local resolver inside VLAN 10 or on a dedicated management VM. Point all DHCP scopes to it so every segment resolves through your stack.</p>
         <div class="exp-box"><strong>Why this matters:</strong> A local resolver gives you network-wide ad and tracker blocking, full DNS query logging for security visibility, and split-horizon DNS so internal hostnames resolve correctly without leaking to upstream.</div>
         <div class="exp-box"><strong>Unbound note:</strong> Unbound running as a recursive resolver queries root servers directly, skipping third-party upstream resolvers entirely. Best privacy posture for a homelab or security-conscious environment.</div>`
      : `<strong>Upstream Resolvers:</strong> Quad9 (9.9.9.9) primary, Cloudflare (1.1.1.1) fallback<br/>
         <p style="font-size:0.9rem;margin-top:6px;margin-bottom:0;">Configured at the DHCP server on your gateway. Quad9 blocks known malicious domains at the resolver level with no client configuration needed.</p>
         <div class="exp-box"><strong>Upgrade path:</strong> Pi-hole or AdGuard Home on a low-power device adds network-wide blocking and per-client query logs when you are ready for it.</div>`;

    // --- Topology ---
    const haWarning = (r.ha === 'yes' && r.budget !== 'high')
      ? `<div class="exp-box"><strong>Note:</strong> True HA (active/active or active/passive failover) requires enterprise-tier hardware and budget. A cold spare is the practical alternative: keep an identical unconfigured unit on the shelf, restore from config backup if the primary fails. Recovery time is measured in minutes rather than seconds, but cost is a fraction of a full HA pair.</div>`
      : '';
    document.getElementById('res-routing').innerHTML = `${haWarning}
      <div class="topology-simple">
        <div class="top-section">WAN EDGE</div><div class="arrow">↓</div>
        <div class="top-section">SECURITY<br/>${hasHA ? 'HA CLUSTER' : 'FIREWALL'}</div><div class="arrow">↓</div>
        <div class="top-section">BACKBONE SWITCH<br/>802.1Q Tagged Trunk</div>
      </div>`;

    // --- FIX: Routing Strategy: loosened condition ---
    const useL3Offload = (
      r.budget !== 'low' &&
      r.density === 'large' &&
      !types.includes('iot')
    );
    document.getElementById('res-protocol').innerHTML = `
      <strong>Method:</strong> ${useL3Offload ? 'L3 Hardware Offloading (SVIs)' : 'Router-on-a-Stick (RoAS)'}<br/>
      <div class="exp-box"><strong>Logic:</strong> ${useL3Offload
        ? 'Internal traffic is routed at the switch level using SVIs, keeping the firewall CPU free for security inspection on external/inter-zone flows.'
        : 'All inter-VLAN traffic is inspected by the gateway. Optimal for your device density and gives full traffic visibility.'}</div>
      <div class="exp-box"><strong>Tradeoff:</strong> ${useL3Offload
        ? 'Higher internal throughput, but some east-west traffic bypasses deep packet inspection.'
        : 'Full firewall visibility at the cost of additional gateway CPU load.'}</div>`;

    // --- Remote Access ---
    const remoteNeeded = types.includes('servers') || types.includes('cameras') || isBiz;
    document.getElementById('res-remote').innerHTML = remoteNeeded
      ? `<strong>VPN Protocol:</strong> ${r.budget === 'low' ? 'Tailscale (Zero-Config Mesh)' : 'WireGuard (Kernel-level, High Perf)'}<br/>
         <p style="font-size:0.9rem;margin-top:6px;">Secure tunnel for off-site access to your ${types.includes('cameras') ? 'surveillance system' : 'internal resources'}.</p>
         <div class="exp-box"><strong>Security Note:</strong> Never expose NVR or NAS ports directly to the internet. Always gate through VPN.</div>`
      : `<strong>Status:</strong> Internal Access Only<br/>
         <p style="font-size:0.9rem;margin-top:6px;">No external ports opened. Maximum attack surface reduction for a local-only environment.</p>`;

    // --- VLANs ---
    let vlan = `<strong>VLAN 10:</strong> Trusted Production<br/>`;
    if (types.includes('iot'))     vlan += `<strong>VLAN 20:</strong> IoT Sandbox (Isolated, no LAN access)<br/>`;
    if (types.includes('cameras')) vlan += `<strong>VLAN 30:</strong> CCTV Private (No WAN egress)<br/>`;
    if (types.includes('guest'))   vlan += `<strong>VLAN 40:</strong> Guest (Internet-only)<br/>`;
    vlan += `<strong>VLAN 99:</strong> Management (OOB, switch/AP admin only)`;
    vlan += `<div class="exp-box"><strong>Policy:</strong> Default-Deny between all zones. Only explicitly permitted flows are allowed. Zero Trust posture.</div>`;
    vlan += `<div class="exp-box"><strong>VLAN 99 note:</strong> Disable inter-VLAN routing for the management VLAN specifically. It should only be reachable from a dedicated admin workstation or jump host, never from production or IoT segments. This is the whole point of an OOB management VLAN.</div>`;
    document.getElementById('res-vlan').innerHTML = vlan;

    // --- Roadmap ---
    document.getElementById('res-security').innerHTML = `
      <div style="margin-top:0.5rem">
        <div style="margin-bottom:10px;display:flex;gap:0.8rem;align-items:baseline"><strong style="color:var(--accent);font-family:'JetBrains Mono',monospace;font-size:0.8rem">01</strong> Physical validation, rack mounting & UPS setup.</div>
        <div style="margin-bottom:10px;display:flex;gap:0.8rem;align-items:baseline"><strong style="color:var(--accent);font-family:'JetBrains Mono',monospace;font-size:0.8rem">02</strong> ISP Bridge Mode, VLAN provisioning & trunk ports.</div>
        <div style="margin-bottom:10px;display:flex;gap:0.8rem;align-items:baseline"><strong style="color:var(--accent);font-family:'JetBrains Mono',monospace;font-size:0.8rem">03</strong> Default-Deny firewall policy rollout.</div>
        <div style="margin-bottom:10px;display:flex;gap:0.8rem;align-items:baseline"><strong style="color:var(--accent);font-family:'JetBrains Mono',monospace;font-size:0.8rem">04</strong> <span><strong>Day 2 Ops:</strong> Deploy Zabbix / Graylog for syslog retention & alerting.</span></div>
        <div style="display:flex;gap:0.8rem;align-items:baseline"><strong style="color:var(--accent);font-family:'JetBrains Mono',monospace;font-size:0.8rem">05</strong> <span><strong>Ongoing:</strong> Establish a firmware patch cadence. Check vendor security advisories monthly. Firewall and switch firmware are the most critical surface to keep current.</span></div>
      </div>`;

    // --- FIX: Storage Layer: now uses r.backup ---
    const storageCard = document.getElementById('storage-card');
    const hasStorageNeed = types.includes('servers') || types.includes('cameras');
    if (hasStorageNeed) {
      storageCard.style.display = 'block';
      let sHtml = '';
      if (types.includes('cameras')) sHtml += `<strong>Surveillance Drives:</strong> WD Purple 4TB+<br/><p style="font-size:0.9rem;margin-bottom:8px;margin-top:3px;">Built for non-stop sequential write workloads (NVR-optimized).</p>`;
      if (types.includes('servers')) sHtml += `<strong>NAS Drives:</strong> Seagate IronWolf<br/><p style="font-size:0.9rem;margin-top:3px;margin-bottom:8px;">Vibration compensation and RAID-optimized firmware for 24/7 array operation.</p>`;
      if (r.backup === 'hybrid') {
        sHtml += `<div class="exp-box"><strong>3-2-1 Backup:</strong> 2 local copies (NAS + external) + 1 encrypted off-site (Backblaze B2 or Wasabi). Use <strong>Duplicati</strong> or <strong>Veeam Agent</strong> for automated jobs.</div>`;
      } else {
        sHtml += `<div class="exp-box"><strong>Local Backup:</strong> Scheduled rsync or Veeam to a secondary drive. Consider at minimum a quarterly cold copy off-site for critical data.</div>`;
      }
      sHtml += `<div class="exp-box"><strong>Architect's Tip:</strong> Standard desktop drives fail within months in 24/7 NAS/NVR systems. Always spec surveillance or NAS-grade media.</div>`;
      document.getElementById('res-storage').innerHTML = sHtml;
    } else {
      storageCard.style.display = 'none';
    }

    // --- Software Stack (Homelab only) ---
    const softwareCard = document.getElementById('software-card');
    if (isLab) {
      softwareCard.style.display = 'block';
      document.getElementById('res-software').innerHTML = `
        <strong>Hypervisor:</strong> Proxmox VE (Type 1 bare-metal)<br/>
        <p style="font-size:0.9rem;margin-top:3px;margin-bottom:8px;">Run virtualized routers, network appliances, and lab VMs in isolation.</p>
        <strong>Firewall OS:</strong> OPNsense / pfSense<br/>
        <p style="font-size:0.9rem;margin-top:3px;margin-bottom:8px;">Enterprise-grade stateful inspection and granular routing control.</p>
        <strong>Containers:</strong> Docker + Portainer CE<br/>
        <p style="font-size:0.9rem;margin-top:3px;margin-bottom:0;">Lightweight, isolated deployment for self-hosted services.</p>
        <div class="exp-box"><strong>Pro Move:</strong> Run <strong>NetBox</strong> in a container for IPAM and rack documentation. Good docs separate a messy lab from a production-grade environment.</div>
      `;
    } else {
      softwareCard.style.display = 'none';
    }

    // --- Why This Works ---
    document.getElementById('res-logic').innerHTML = `
      <div>
        <h4 style="color:var(--accent);margin-bottom:10px;font-family:'Syne',sans-serif;">Isolation Strategy</h4>
        <p>Untrusted devices (IoT, guest traffic, cameras) are segmented into isolated VLANs with a Default-Deny policy. This stops lateral movement if any device is compromised. A breach on the IoT VLAN cannot reach your NAS or production machines.</p>
        <div class="exp-box"><strong>Tradeoff:</strong> More VLANs = more firewall rules. Maintain a rule comment discipline. Every ACE should have a purpose noted.</div>
      </div>
      <div>
        <h4 style="color:var(--accent);margin-bottom:10px;font-family:'Syne',sans-serif;">Routing Design</h4>
        <p>${useL3Offload
          ? 'Inter-VLAN traffic is forwarded at the switch ASIC level using SVIs, dramatically reducing firewall CPU load at high device density.'
          : 'All inter-VLAN traffic passes through the firewall for deep packet inspection. This maximises visibility and simplifies policy management at your current scale.'}</p>
        <div class="exp-box"><strong>Tradeoff:</strong> ${useL3Offload
          ? 'Better east-west throughput, but you lose per-flow firewall inspection on internal routes.'
          : 'Full traffic visibility, at the cost of gateway CPU overhead as device count grows.'}</div>
      </div>`;

    // Final reveal
    const res = document.getElementById('results');
    res.style.display = 'block';
    setTimeout(() => {
      res.style.opacity = '1';
      res.scrollIntoView({ behavior: 'smooth' });
      setTimeout(revealCards, 200);
    }, 80);
  }

  // --- PDF Export (built from answers, not DOM) ---
  window.downloadPDF = function() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    const r = answers;
    const types = r.types || [];
    const hasHA = r.ha === 'yes' && r.budget === 'high';

    const audienceMap = { home: 'Home', business: 'Business', homelab: 'Homelab' };
    const densityMap  = { small: '1–20 Devices', medium: '21–60 Devices', large: '61+ Devices' };
    const costMap     = { low: '$150 – $450', mid: '$700 – $1,500', high: '$2,500 – $4,000+' };

    const accent = [16, 185, 129];
    let y = 22;

    // Header bar
    doc.setFillColor(8, 14, 26);
    doc.rect(0, 0, 210, 30, 'F');
    doc.setTextColor(16, 185, 129);
    doc.setFontSize(16);
    doc.setFont('helvetica', 'bold');
    doc.text('NETWORK ARCHITECTURE REPORT', 20, 14);
    doc.setFontSize(9);
    doc.setTextColor(125, 149, 181);
    doc.text(`Generated: ${new Date().toLocaleDateString()}`, 20, 22);
    doc.setTextColor(0, 0, 0);

    y = 40;

    // Summary box
    doc.setFillColor(240, 250, 245);
    doc.roundedRect(14, y - 4, 182, 28, 2, 2, 'F');
    doc.setFontSize(9);
    doc.setFont('helvetica', 'bold');
    doc.setTextColor(...accent);
    doc.text('ENVIRONMENT', 20, y + 4);  doc.setTextColor(30, 30, 30); doc.setFont('helvetica', 'normal'); doc.text(audienceMap[r.audience], 20, y + 10);
    doc.setFont('helvetica', 'bold'); doc.setTextColor(...accent);
    doc.text('SCALE', 65, y + 4);        doc.setTextColor(30, 30, 30); doc.setFont('helvetica', 'normal'); doc.text(densityMap[r.density], 65, y + 10);
    doc.setFont('helvetica', 'bold'); doc.setTextColor(...accent);
    doc.text('BUDGET', 115, y + 4);      doc.setTextColor(30, 30, 30); doc.setFont('helvetica', 'normal'); doc.text(r.budget.toUpperCase(), 115, y + 10);
    doc.setFont('helvetica', 'bold'); doc.setTextColor(...accent);
    doc.text('EST. COST', 155, y + 4);   doc.setTextColor(30, 30, 30); doc.setFont('helvetica', 'normal'); doc.text(costMap[r.budget], 155, y + 10);
    y += 36;

    function section(title, lines) {
      // Accent bar
      doc.setFillColor(...accent);
      doc.rect(14, y, 3, 7, 'F');
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(11);
      doc.setTextColor(30, 30, 30);
      doc.text(title, 20, y + 5.5);
      y += 12;
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(9.5);
      doc.setTextColor(60, 60, 60);
      for (const line of lines) {
        const wrapped = doc.splitTextToSize(line, 172);
        doc.text(wrapped, 20, y);
        y += wrapped.length * 5;
      }
      y += 6;
      if (y > 265) { doc.addPage(); y = 20; }
    }

    // Hardware
    const hwLines = r.budget === 'high'
      ? [`Edge: Netgate 6100 ${hasHA ? 'HA Pair' : '(Standalone)'}`, `Core Switch: Cisco Catalyst 9200L`, `WLAN: 2x UniFi U7 Pro (Wi-Fi 7)`]
      : r.budget === 'mid'
      ? [`Gateway: UniFi Cloud Gateway Max`, `Switch: UniFi Pro Max 16 PoE`, `WLAN: 2x UniFi U7 Pro`]
      : [`Gateway: x86 Mini PC (OPNsense)`, `Switch: TP-Link L2 Managed`, `WLAN: TP-Link Omada AP`];
    section('Hardware Stack', hwLines);

    // VLANs
    const vlanLines = ['VLAN 10: Trusted Production'];
    if (types.includes('iot'))     vlanLines.push('VLAN 20: IoT Sandbox (Isolated)');
    if (types.includes('cameras')) vlanLines.push('VLAN 30: CCTV Private (No WAN)');
    if (types.includes('guest'))   vlanLines.push('VLAN 40: Guest (Internet-only)');
    vlanLines.push('VLAN 99: Management (OOB)', 'Policy: Default-Deny between all zones (Zero Trust)');
    section('Security Zones', vlanLines);

    const useL3Offload = r.budget !== 'low' && r.density === 'large' && !types.includes('iot');
    section('Routing Strategy', [
      `Method: ${useL3Offload ? 'L3 Hardware Offloading (SVIs)' : 'Router-on-a-Stick (RoAS)'}`,
      useL3Offload
        ? 'Internal traffic routed at switch level to reduce firewall CPU load.'
        : 'All inter-VLAN traffic inspected at the gateway for full visibility.'
    ]);

    const remoteNeeded = types.includes('servers') || types.includes('cameras') || r.audience === 'business';
    section('Remote Access', remoteNeeded
      ? [`VPN: ${r.budget === 'low' ? 'Tailscale (Zero-Config)' : 'WireGuard (High Performance)'}`, 'Secure external access, no direct internet exposure of internal services.']
      : ['Status: Internal Access Only. No external ports opened.']
    );

    section('Power & Physical', [
      `Rack: ${r.audience === 'home' ? 'StarTech 6U Wall Mount' : '12U Open Frame Server Rack'}`,
      `Power: ${r.power === 'ups' ? 'APC Smart-UPS 1500VA' : 'CyberPower Surge Protector'}`,
      r.power === 'ups' ? 'UPS provides runtime buffer and graceful shutdown via SNMP.' : 'Upgrade to UPS recommended for future hardware protection.'
    ]);

    section('ISP & External Link', [
      'Modem Configuration: Bridge Mode / IP Passthrough',
      'Bridge Mode avoids Double NAT, critical for VPN stability.',
      'Note: Some ISPs (AT&T Fiber, Comcast XB) resist true bridge mode. Verify support first. IP Passthrough is the fallback.'
    ]);

    const dnsLocalPdf = r.audience !== 'home' || (r.types||[]).includes('iot') || (r.types||[]).includes('servers');
    section('DNS Architecture', dnsLocalPdf
      ? [
          'Upstream: Quad9 (9.9.9.9) + Cloudflare (1.1.1.1) fallback',
          `Local Resolver: ${r.budget === 'low' ? 'Pi-hole' : 'AdGuard Home or Unbound (recursive)'}`,
          'Point all DHCP scopes at the local resolver for network-wide visibility and split-horizon DNS.'
        ]
      : [
          'Upstream: Quad9 (9.9.9.9) primary, Cloudflare (1.1.1.1) fallback',
          'Configured at DHCP server. Quad9 blocks malicious domains at resolver level.'
        ]
    );

    if (types.includes('servers') || types.includes('cameras')) {
      const backupDetail = r.backup === 'hybrid'
        ? '3-2-1 backup: NAS primary + external copy + encrypted cloud (Backblaze B2 / Wasabi).'
        : 'Local-only backup via rsync or Veeam to a secondary drive.';
      section('Storage & Backup', [
        types.includes('cameras') ? 'Surveillance Drives: WD Purple (NVR-optimized)' : '',
        types.includes('servers') ? 'NAS Drives: Seagate IronWolf (RAID-optimized)' : '',
        backupDetail
      ].filter(Boolean));
    }

    section('Deployment Roadmap', [
      '01 / Physical validation, rack mount & UPS setup',
      '02 / ISP Bridge Mode, VLAN & trunk provisioning',
      '03 / Default-Deny firewall policy rollout',
      '04 / Day 2: Monitoring (Zabbix/Graylog), syslog retention'
    ]);

    // Footer
    const pages = doc.getNumberOfPages();
    for (let p = 1; p <= pages; p++) {
      doc.setPage(p);
      doc.setFontSize(8);
      doc.setTextColor(160, 160, 160);
      doc.text('network-advisor.dannyhoang.dev', 20, 290);
      doc.text(`Page ${p} of ${pages}`, 185, 290, { align: 'right' });
    }

    doc.save(`Network-Blueprint-${audienceMap[r.audience]}-${Date.now()}.pdf`);
  };

  // --- Markdown Export ---
  window.exportMarkdown = function() {
    const r = answers;
    const types = r.types || [];
    const isLab = r.audience === 'homelab';
    const hasHA = r.ha === 'yes' && r.budget === 'high';
    const audienceMap = { home: 'Home', business: 'Business', homelab: 'Homelab' };
    const costMap = { low: '$150 – $450', mid: '$700 – $1,500', high: '$2,500 – $4,000+' };

    let md = `# Network Architecture: ${audienceMap[r.audience].toUpperCase()}\n\n`;
    md += `> **Scale:** ${r.density} | **Budget:** ${r.budget} | **HA:** ${hasHA ? 'Enabled' : 'Standard'} | **Est. Cost:** ${costMap[r.budget]}\n\n`;
    md += `## Hardware Stack\n${document.getElementById('res-hardware').innerText.replace(/\n{3,}/g, '\n\n')}\n\n`;
    md += `## Security Zones\n${document.getElementById('res-vlan').innerText.replace(/\n{3,}/g, '\n\n')}\n\n`;
    md += `## Routing Strategy\n${document.getElementById('res-protocol').innerText.replace(/\n{3,}/g, '\n\n')}\n\n`;
    md += `## Remote Access\n${document.getElementById('res-remote').innerText.replace(/\n{3,}/g, '\n\n')}\n\n`;
    md += `## Power Layer\n${document.getElementById('res-power').innerText.replace(/\n{3,}/g, '\n\n')}\n\n`;
    md += `## Deployment Roadmap\n${document.getElementById('res-security').innerText.replace(/\n{3,}/g, '\n\n')}\n\n`;
    if (isLab) md += `## Software Stack\n${document.getElementById('res-software').innerText.replace(/\n{3,}/g, '\n\n')}\n\n`;
    const storageEl = document.getElementById('res-storage');
    if (storageEl && document.getElementById('storage-card').style.display !== 'none') {
      md += `## Storage & Backup\n${storageEl.innerText.replace(/\n{3,}/g, '\n\n')}\n\n`;
    }
    md += `---\n*Generated by [Network Blueprint Advisor](https://network-advisor.dannyhoang.dev)*\n`;

    navigator.clipboard.writeText(md)
      .then(() => showToast('Markdown copied to clipboard.'))
      .catch(() => showToast('Clipboard access denied. Please copy manually.'));
  };

  updateNavUI();
</script>